# Thin root .gitignore for the mono-repo (ADR-0010).
#
# .gitignore is NESTED, not hoisted: the back-end's .gitignore opens with `.*`
# and MUST stay scoped to backend/ — at the root it would swallow committed
# dotfiles (.github/.vscode/.claude). Never add `.*` here.
#
# Front-end ignores live in frontend/.gitignore; back-end ignores in
# backend/.gitignore. This file covers only root-level, cross-cutting artifacts.

# System files (all trees)
.DS_Store
Thumbs.db

# Root-level tooling & orchestration artifacts
/node_modules/
/.output/
/.vinxi/
/reports/
/coverage/
.superpowers/

# Environment (real secrets never committed)
.env
.env*.local

# Snyk Security Extension — AI Rules (auto-generated)
.github/instructions/snyk_rules.instructions.md
