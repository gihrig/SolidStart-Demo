{
  "name": "solidstart-demo",
  "type": "module",
  "scripts": {
    "audit": "bun audit",
    "build": "vinxi build",
    "check": "vp check --fix",
    "check:type": "vpx tsc --noEmit",
    "dev": "vinxi dev",
    "lighthouse": "concurrently -g 'vinxi build' 'vinxi start' 'CHROME_PATH=\"/Applications/Brave Browser.app/Contents/MacOS/Brave Browser\" lighthouse http://localhost:3000 --output html --output-path ./reports/lighthouse/lighthouse-report.html --view'",
    "prepare": "vp config --no-agent",
    "start": "vinxi start",
    "test:all": "vp test",
    "test:all:watch": "vp test --watch",
    "test:comp": "vp test src/components",
    "test:comp:watch": "vp test src/components --watch",
    "test:cover": "vp test src --coverage --coverage.reportsDirectory=reports/coverage",
    "test:e2e": "./src/lib/test-e2e.sh",
    "test:show": "playwright show-report reports/playwright-report",
    "test:unit": "vp test src/lib",
    "test:unit:watch": "vp test --watch src/lib",
    "update": "bun update",
    "update:latest": "bun update --latest"
  },
  "dependencies": {
    "@fontsource/lobster": "5.3.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@playwright/test": "1.63.0",
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "0.16.2",
    "@solidjs/start": "1.3.2",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "@vinxi/plugin-mdx": "3.7.2",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "concurrently": "10.0.5",
    "happy-dom": "20.14.5",
    "jsdom": "30.1.0",
    "postcss": "8.5.28",
    "solid-js": "1.9.15",
    "solid-mdx": "0.0.7",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinxi": "0.5.11",
    "vite": "8.3.0",
    "vite-plugin-solid": "2.11.14",
    "vite-plus": "0.2.5"
  },
  "overrides": {
    "@vitest/browser": "4.1.11",
    "@vitest/browser-preview": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/expect": "4.1.11",
    "@vitest/mocker": "4.1.11",
    "@vitest/pretty-format": "4.1.11",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "@vitest/spy": "4.1.11",
    "@vitest/ui": "4.1.11",
    "@vitest/utils": "4.1.11",
    "h3": "1.15.11",
    "shell-quote": "1.9.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.11",
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
